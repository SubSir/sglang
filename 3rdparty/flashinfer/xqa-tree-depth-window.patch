+      uint32_t rowDepth = 0;
+#pragma unroll
+      for (uint32_t w = 0; w < nbPackedMasksPerRow; w++) {
+        rowDepth += __popc(uint32_t(uint16Mask[tokenRow * nbPackedMasksPerRow + w]));
+      }
+      int32_t const rowWinBeg = winBegBase + int32_t(rowDepth) - 1;
 #endif
